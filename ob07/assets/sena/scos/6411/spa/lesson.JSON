edback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 1, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le04ob07re7pdf01.pdf"}]}]}], "type": "DWS", "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Role-play explaining a mistake."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le04ob07re2img05.jpg", "audiosrc": "engenn9le04ob07re2aud01", "images": [{"time": "0", "image": "engenn9le04ob07re2img05.jpg", "text": "", "id": 0}, {"time": "10", "image": "engenn9le04ob07re2img05.jpg", "text": "<span class=\"strong\">Sally</span>: Hello?<br/>\n<span class=\"strong\">Vanessa</span>: Hey, Sally.<br/>\n<span class=\"strong\">Sally</span>: What's up? You sound cranky.<br/>\n<span class=\"strong\">Vanessa</span>: I should have taken my own advice about being more aware of other people's emotions.<br/>\n<span class=\"strong\">Sally</span>: Why? What happened?<br/>\n<span class=\"strong\">Vanessa</span>: I got into a bit of an argument with one of my employees and it could have been avoided. <br/>\n<span class=\"strong\">Sally</span>: Tell me what happened. <br/>\n<span class=\"strong\">Vanessa</span>: One of the waitresses told me a few days ago that she couldn't work yesterday. I should have written it down but I was busy and frazzled so I didn't. So, of course, I forgot.", "id": 1}, {"time": "27750", "image": "engenn9le04ob07re2img05.jpg", "text": "<span class=\"strong\">Sally</span>: Ooops. But maybe she should have written it down, or sent you an e-mail.<br/>\n<span class=\"strong\">Vanessa</span>: That would have been helpful, yes. But anyway, when she didn't show up for her shift yesterday, I was furious! We had so many reservations and I really needed her.<br/>\n<span class=\"strong\">Sally</span>: So what did you do?<br/>\n<span class=\"strong\">Vanessa</span>: I called her cell. She answered and I immediately started yelling at her, and asked her why she wasn't at work. <br/>\n<span class=\"strong\">Sally</span>: And ... ?", "id": 2}, {"time": "53500", "image": "engenn9le04ob07re2img02.jpg", "text": "<span class=\"strong\">Vanessa</span>: After I stopped flipping out on her, she reminded me that she had told me she couldn't work the shift. And she told me that she was at a funeral. <br/>\n<span class=\"strong\">Sally</span>: Oh no! What did you do?<br/>\n<span class=\"strong\">Vanessa</span>: I apologized, of course. I feel terrible. And apparently everyone else at the restaurant knew about the funeral but I was so immersed in myself that I didn't notice how upset she was.<br/>\n<span class=\"strong\">Sally</span>: Well, when you see her you can apologize in person. And then start working on your emotional intelligence.", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}]}